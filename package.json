{
  "name": "@sue445/rb-wasm-vdom",
  "version": "0.6.0",
  "description": "A reactive Virtual DOM library for ruby.wasm and PicoRuby.wasm",
  "keywords": [
    "Ruby",
    "PicoRuby",
    "WASM",
    "vdom"
  ],
  "homepage": "https://github.com/sue445/rb-wasm-vdom",
  "bugs": {
    "url": "https://github.com/sue445/rb-wasm-vdom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sue445/rb-wasm-vdom.git"
  },
  "license": "MIT",
  "author": "sue445",
  "type": "module",
  "main": "./dist/rb-wasm-vdom.es.js",
  "module": "./dist/rb-wasm-vdom.es.js",
  "jsdelivr": "./dist/rb-wasm-vdom.rb",
  "exports": {
    ".": "./dist/rb-wasm-vdom.es.js",
    "./rb": "./dist/rb-wasm-vdom.rb"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node scripts/build-ruby.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:build",
    "test:build": "node --test 'test/build/*.test.js'",
    "test:integration": "npm run build && playwright test test/integration/",
    "test:unit": "npm run test:unit:ruby-wasm-head && npm run test:unit:picoruby-wasm-wasi-latest",
    "test:unit:picoruby-wasm-wasi-latest": "node test/unit/test_runner.js picoruby-wasm-wasi-latest",
    "test:unit:ruby-wasm-head": "node test/unit/test_runner.js ruby-wasm-head"
  },
  "devDependencies": {
    "@picoruby/wasm-wasi": "^4.0.0",
    "@playwright/test": "^1.61.1",
    "@ruby/3.2-wasm-wasi": "^2.9.3-2.9.4",
    "@ruby/3.3-wasm-wasi": "^2.9.3-2.9.4",
    "@ruby/3.4-wasm-wasi": "^2.9.3-2.9.4",
    "@ruby/head-wasm-wasi": "^2.9.3-2.9.4",
    "vite": "^8.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
